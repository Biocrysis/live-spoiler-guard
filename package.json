  "description": "Bot de moderación anti-spoilers para YouTube Live y TikTok Live",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "youtube": "node src/index.js --youtube",
    "tiktok": "node src/index.js --tiktok",
