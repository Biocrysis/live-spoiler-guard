# ============================================
# BOT ANTI-SPOILERS - CONFIGURACIÓN
# ============================================
# Copia este archivo como .env y completa los valores

# --- YouTube Configuration ---
# Obtén tus credenciales en: https://console.cloud.google.com/
# Necesitas habilitar "YouTube Data API v3"
YOUTUBE_CLIENT_ID=tu_client_id_aqui
YOUTUBE_CLIENT_SECRET=tu_client_secret_aqui
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_REFRESH_TOKEN=tu_refresh_token_aqui

# ID del canal de YouTube (se encuentra en YouTube Studio → Configuración → Canal)
YOUTUBE_CHANNEL_ID=tu_channel_id_aqui

# --- TikTok Configuration ---
# Username de TikTok (sin @)
TIKTOK_USERNAME=tu_username_aqui

# --- Twitch Configuration ---
# Username de la cuenta bot (puede ser tu misma cuenta)
TWITCH_BOT_USERNAME=tu_bot_username
# OAuth token - Obtener en: https://twitchapps.com/tmi/
TWITCH_OAUTH_TOKEN=oauth:tu_token_aqui
# Canal a monitorear (sin #)
TWITCH_CHANNEL=tu_canal
# Acción al detectar spoiler: delete | warn
TWITCH_SPOILER_ACTION=delete
# Timeout en segundos tras 3 strikes (0 = sin timeout)
TWITCH_TIMEOUT_SECONDS=300

# --- Kick Configuration ---
# Username de Kick (sin @, el streamer cuyo live quieres monitorear)
KICK_USERNAME=tu_username_kick

# --- Facebook Configuration ---
# ID de la página de Facebook (los lives deben ser en una Page, no perfil personal)
FACEBOOK_PAGE_ID=tu_page_id
# Page Access Token (obtener en Graph API Explorer con permisos de moderación)
FACEBOOK_PAGE_ACCESS_TOKEN=tu_page_access_token
# Acción al detectar spoiler: delete | hide
FACEBOOK_SPOILER_ACTION=hide
# Intervalo de polling de comentarios en ms
FACEBOOK_POLL_INTERVAL=5000

# --- Bot Behavior ---
# Acción al detectar spoiler en YouTube: delete | hide | warn
YOUTUBE_SPOILER_ACTION=delete

# Tiempo de timeout en segundos para usuarios que hacen spoiler (0 = sin timeout)
YOUTUBE_TIMEOUT_SECONDS=300

# Enviar mensaje de advertencia en el chat cuando se detecta spoiler (true/false)
SEND_WARNING_MESSAGE=true

# Mensaje de advertencia personalizado
WARNING_MESSAGE=⚠️ Mensaje eliminado por posible spoiler. Por favor respeta a quienes no han terminado el juego.

# --- Notifications ---
# Activar notificaciones de escritorio (true/false)
DESKTOP_NOTIFICATIONS=true

# Activar sonido de alerta (true/false)
SOUND_ALERTS=true

# --- Detection Settings ---
# Sensibilidad de detección: low | medium | high
DETECTION_SENSITIVITY=medium

# Usar detección contextual con IA (requiere API key de OpenAI) (true/false)
USE_AI_DETECTION=false

# OpenAI API Key (opcional, solo si USE_AI_DETECTION=true)
OPENAI_API_KEY=tu_openai_key_aqui

# --- Logging ---
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Guardar log en archivo (true/false)
SAVE_LOGS=true
